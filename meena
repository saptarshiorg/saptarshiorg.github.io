<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Prime JSON — Match Board UI</title>

  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,600,700&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0a0b0d; --card:#131519; --card-2:#1a1d22; --border:#26292f; --muted:#9aa0a8;
      --text:#f5f6f8; --accent:#ff5a1f; --soft:#ff5a1f22; --radius:6px;
      --max-width:1200px;
      font-family:'Satoshi', system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }
    *{box-sizing:border-box}
    html,body{height:100%;margin:0;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
    .app{max-width:var(--max-width);margin:0 auto;padding:18px 16px 60px}
    header{
      position:sticky; top:0; z-index:30; background:rgba(10,11,13,0.85);
      backdrop-filter: blur(8px); border-bottom:1px solid var(--border);
      display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px;
    }
    .brand{display:flex;align-items:center;gap:12px}
    .brand img{height:34px}
    .last-update{font-size:12px;color:var(--muted);font-weight:600;letter-spacing:.4px}
    .controls{display:flex;gap:10px;align-items:center}
    .search-wrap{position:relative}
    .search-wrap input{
      width:320px; max-width:60vw; padding:10px 36px 10px 40px;
      border-radius:0; border:1px solid var(--border); background:var(--card); color:var(--text);
      font-weight:600; letter-spacing:.3px; outline:none;
    }
    .search-wrap svg{ position:absolute; left:10px; top:50%; transform:translateY(-50%); opacity:.6 }
    .btn{padding:9px 12px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text);cursor:pointer;font-weight:700}
    .btn.primary{background:var(--accent);border-color:transparent;color:#fff}
    .grid{
      margin-top:20px;
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));
      gap:18px;
    }

    .card{background:var(--card);border:1px solid var(--border);border-radius:6px;overflow:hidden;display:flex;flex-direction:column}
    .thumb{position:relative;height:160px;background:#000;display:flex;align-items:center;justify-content:center}
    .thumb img{width:100%;height:100%;object-fit:cover;display:block}
    .meta{padding:12px 12px 14px;display:flex;flex-direction:column;gap:8px;flex:1}
    .title{font-weight:800;font-size:15px;letter-spacing:.2px;text-transform:uppercase}
    .subtitle{font-size:12px;color:var(--muted);font-weight:600}
    .time{font-size:12px;color:var(--muted);font-weight:700}
    .status-badge{position:absolute;top:10px;right:10px;padding:6px 9px;font-weight:800;border-radius:4px;font-size:11px;display:flex;gap:8px;align-items:center}
    .status-live{color:var(--accent);border:1px solid rgba(255,90,31,.18);background:linear-gradient(180deg, rgba(255,90,31,.04), transparent)}
    .status-up{color:#c7cad0;border:1px solid rgba(138,143,153,.18);background:transparent}
    .actions{margin-top:auto;display:flex;gap:8px;align-items:center}
    .watch{flex:1;padding:10px 12px;border-radius:6px;border:none;background:var(--accent);color:#fff;font-weight:800;cursor:pointer}
    .ww{padding:9px 10px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text);font-weight:700;cursor:pointer}
    .ww.open{border-color:var(--accent);color:var(--accent)}
    .ww-panel{overflow:hidden;max-height:0;transition:max-height .28s ease,opacity .18s;opacity:0}
    .ww-panel.open{max-height:240px;opacity:1;margin-top:8px}
    .ww-row{display:flex;align-items:center;gap:10px;padding:8px;border-radius:6px;background:var(--card-2);border:1px solid var(--border);cursor:pointer}
    .empty{grid-column:1/-1;text-align:center;padding:44px 18px;border:1px dashed var(--border);color:var(--muted)}
    .modal{
      position:fixed;inset:0;display:grid;place-items:center;background:rgba(2,4,8,.6);padding:18px;opacity:0;pointer-events:none;transition:opacity .18s;
    }
    .modal[open]{opacity:1;pointer-events:auto}
    .modal-card{width:min(900px,96%);max-height:86vh;overflow:auto;background:var(--card);border:1px solid var(--border);padding:16px;border-radius:8px}
    .modal-close{position:absolute;right:18px;top:18px;border:none;background:transparent;color:var(--muted);font-weight:800;font-size:18px;cursor:pointer}
    footer{margin-top:36px;padding-top:14px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
    .vc{display:flex;gap:12px;align-items:center}
    .vc .val{font-weight:800;font-size:15px}
    @media (max-width:520px){ .search-wrap input{width:180px} .brand img{height:26px} }
  </style>
</head>
<body>
  <div class="app">
    <header>
      <div class="brand">
        <img src="https://raw.githubusercontent.com/saptarshiorg/saptarshiorg.github.io/refs/heads/main/magenta.png" alt="logo">
        <div class="last-update" id="lastUpdate">LAST UPDATE: LOADING...</div>
      </div>

      <div class="controls">
        <div class="search-wrap" title="Search title / subtitle">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input id="search" placeholder="SEARCH MATCH / TITLE..." />
        </div>
        <button id="refresh" class="btn" title="Refresh">Refresh</button>
        <button id="proxy" class="btn">Retry with CORS proxy</button>
      </div>
    </header>

    <main>
      <div id="grid" class="grid">
        <div class="empty" id="loading">LOADING MATCHES...</div>
      </div>

      <dialog id="modal" class="modal" aria-hidden="true">
        <div class="modal-card">
          <button id="closeModal" class="modal-close">✕</button>
          <pre id="modalContent" style="white-space:pre-wrap;color:var(--muted);font-size:13px"></pre>
        </div>
      </dialog>
    </main>

    <footer>
      <div class="note">UI inspired by FanCode • Built by you</div>
      <div class="vc" id="visitorCounter">
        <div><div class="val" id="vcTotal">—</div><div style="font-size:11px;color:var(--muted)">Visits</div></div>
        <div style="width:1px;height:28px;background:var(--border)"></div>
        <div><div class="val" id="vcUnique">—</div><div style="font-size:11px;color:var(--muted)">Unique</div></div>
      </div>
    </footer>
  </div>

  <script>
  (function(){
    const DATA_URL = 'https://sonujson-devloper.vercel.app/Data/prime.json';
    const CORS_PROXY = 'https://api.allorigins.win/raw?url=';
    const CACHE_KEY = 'prime_ui_cache_v1';
    const CACHE_TTL = 1000 * 60 * 5; // 5 minutes

    const grid = document.getElementById('grid');
    const loading = document.getElementById('loading');
    const lastUpdateEl = document.getElementById('lastUpdate');
    const searchEl = document.getElementById('search');
    const refreshBtn = document.getElementById('refresh');
    const proxyBtn = document.getElementById('proxy');
    const modal = document.getElementById('modal');
    const modalContent = document.getElementById('modalContent');
    const closeModal = document.getElementById('closeModal');
    const vcTotal = document.getElementById('vcTotal');
    const vcUnique = document.getElementById('vcUnique');

    let dataRaw = [];
    let snapshot = null;
    let openWW = new Set();

    function setLastUpdate(d){
      if(!d) return lastUpdateEl.textContent = 'LAST UPDATE: UNAVAILABLE';
      try { lastUpdateEl.textContent = 'LAST UPDATE: ' + (new Date(d)).toLocaleString('en-IN', { hour12:true }); } catch(e){}
    }

    function saveCache(obj){
      try{ localStorage.setItem(CACHE_KEY, JSON.stringify({ts:Date.now(), data: obj})); }catch(e){}
    }
    function loadCache(){
      try{
        const raw = localStorage.getItem(CACHE_KEY);
        if(!raw) return null;
        const o = JSON.parse(raw);
        if(Date.now() - o.ts > CACHE_TTL) return null;
        return o.data;
      }catch(e){ return null; }
    }

    function pickTitle(item){
      return item.title || item.name || item.label || item.teams || item.event || item.match || String(item.id || '').toUpperCase() || 'Untitled';
    }
    function pickSubtitle(item){
      return item.tournament || item.league || item.category || item.series || item.subtitle || '';
    }
    function pickImage(item){
      return item.image || item.thumb || item.poster || item.artwork || '';
    }
    function pickTime(item){
      // common time fields
      const candidates = [item.time, item.startTime, item.date, item.datetime, item.matchTime, item.updatedAt];
      for(const c of candidates){
        if(!c) continue;
        const d = new Date(c);
        if(!isNaN(d)) return d;
        // try parsing common formats
        const parsed = Date.parse(String(c));
        if(!isNaN(parsed)) return new Date(parsed);
      }
      return null;
    }
    function pickStatus(item){
      const s = String(item.status || '').toUpperCase();
      if(s.includes('LIVE') || s.includes('ON AIR')) return 'LIVE';
      if(s.includes('COMPLETE') || s.includes('FINISH') || s.includes('RESULT')) return 'COMPLETED';
      return 'UPCOMING';
    }

    function timeLabel(d){
      if(!d) return 'TIME TBA';
      const opts = { day:'2-digit', month:'short' };
      const datePart = d.toLocaleDateString('en-IN', opts).toUpperCase();
      let h = d.getHours(); const mm = String(d.getMinutes()).padStart(2,'0'); const ap = h >= 12 ? 'PM' : 'AM';
      h = h % 12; if(h === 0) h = 12;
      return `${datePart}, ${h}:${mm} ${ap}`;
    }

    function cardHTML(it, idx){
      const title = escapeHtml(pickTitle(it));
      const subtitle = escapeHtml(pickSubtitle(it));
      const image = escapeHtml(pickImage(it)) || '';
      const time = pickTime(it);
      const timelbl = time ? timeLabel(time) : (it.time_text || 'TIME TBA');
      const status = pickStatus(it);
      const statusClass = status === 'LIVE' ? 'status-live' : 'status-up';
      const hasImage = image.length > 6;
      // build WW options if present
      const ww = [];
      if(it.lk) ww.push({k:'LK', flag:'🇱🇰', url:it.lk});
      if(it.np) ww.push({k:'NP', flag:'🇳🇵', url:it.np});
      if(it.bd) ww.push({k:'BD', flag:'🇧🇩', url:it.bd});
      // use id fallback
      const id = it.id || it.match_id || ('i'+idx);

      return `
        <article class="card" data-idx="${idx}">
          <div class="thumb">
            <img src="${hasImage ? image : 'https://www.fancode.com/skillup-uploads/cms-media/Cricket_Fallback_Old_match-card.jpg'}" alt="${title}" loading="lazy" onerror="this.onerror=null;this.src='https://www.fancode.com/skillup-uploads/cms-media/Cricket_Fallback_Old_match-card.jpg'">
            <div class="status-badge ${statusClass}">${status}</div>
          </div>

          <div class="meta">
            <div class="title">${title}</div>
            <div class="subtitle">${subtitle}</div>
            <div class="time">${timelbl}</div>

            <div class="actions">
              <button class="watch" data-idx="${idx}">VIEW DETAILS</button>
              ${ ww.length ? `<button class="ww ${openWW.has(String(id)) ? 'open' : ''}" data-id="${id}" data-idx="${idx}">WORLDWIDE</button>` : ''}
            </div>

            ${ ww.length ? `<div class="ww-panel ${openWW.has(String(id)) ? 'open' : ''}" data-panel="${id}">
              ${ww.map(o=>`<div class="ww-row" data-url="${escapeHtml(o.url)}"><span style="font-size:16px">${o.flag}</span><div style="flex:1;font-weight:700">${escapeHtml(o.k)} / ${escapeHtml(title)}</div><div style="font-size:11px;color:var(--muted)">${escapeHtml(o.k)}</div></div>`).join('')}
            </div>` : '' }
          </div>
        </article>
      `;
    }

    function renderGrid(list){
      if(!list || list.length === 0){
        grid.innerHTML = `<div class="empty">No matches found.</div>`;
        return;
      }
      grid.innerHTML = list.map((it, i) => cardHTML(it,i)).join('');
    }

    function escapeHtml(s){
      return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function attachDelegation(){
      grid.addEventListener('click', (ev) => {
        const watch = ev.target.closest('.watch');
        if(watch){
          const idx = +watch.dataset.idx;
          openDetails(idx);
          return;
        }
        const wwbtn = ev.target.closest('.ww');
        if(wwbtn){
          const id = wwbtn.dataset.id;
          const panel = grid.querySelector(`.ww-panel[data-panel="${id}"]`);
          if(panel){
            const will = !panel.classList.contains('open');
            panel.classList.toggle('open', will);
            wwbtn.classList.toggle('open', will);
            if(will) openWW.add(String(id)); else openWW.delete(String(id));
          }
          return;
        }
        const wwrow = ev.target.closest('.ww-row');
        if(wwrow && wwrow.dataset.url){
          window.open(wwrow.dataset.url, '_blank');
        }
      });

      grid.addEventListener('keydown', (e) => {
        if(e.key !== 'Enter' && e.key !== ' ') return;
        const wwrow = e.target.closest('.ww-row');
        if(wwrow && wwrow.dataset.url){ window.open(wwrow.dataset.url, '_blank'); }
      });
    }

    function openDetails(idx){
      const item = dataRaw[idx];
      if(!item) return;
      modalContent.textContent = JSON.stringify(item, null, 2);
      modal.setAttribute('open','');
      modal.removeAttribute('aria-hidden');
    }

    closeModal.addEventListener('click', ()=>{ modal.removeAttribute('open'); modal.setAttribute('aria-hidden','true') });
    modal.addEventListener('click', (e)=>{ if(e.target === modal) { modal.removeAttribute('open'); modal.setAttribute('aria-hidden','true') } });

    function applySearch(){
      const q = (searchEl.value || '').trim().toLowerCase();
      if(!q) { renderGrid(dataRaw); return; }
      const filtered = dataRaw.filter(it => {
        const t = (pickTitle(it)+' '+pickSubtitle(it)).toLowerCase();
        return t.includes(q);
      });
      renderGrid(filtered);
    }

    searchEl.addEventListener('input', () => { applySearch(); });

    refreshBtn.addEventListener('click', () => { localStorage.removeItem(CACHE_KEY); loadData(DATA_URL, true); });
    proxyBtn.addEventListener('click', () => { loadData(CORS_PROXY + encodeURIComponent(DATA_URL), true); });

    function loadVisitorCounter(){
      // optional: dummy/replace with your real counter endpoint
      try{
        // hide or set placeholders if you don't have a real counter
        vcTotal.textContent = '—'; vcUnique.textContent = '—';
      }catch(e){}
    }

    function useCacheIfPresent(){
      const cached = loadCache();
      if(cached && Array.isArray(cached)){
        dataRaw = cached;
        renderGrid(dataRaw);
        setLastUpdate(null);
      }
    }

    async function loadData(url, force=false){
      try{
        loading && (loading.textContent = 'LOADING MATCHES...');
        if(!force){
          const cached = loadCache();
          if(cached && Array.isArray(cached)){
            dataRaw = cached;
            renderGrid(dataRaw);
            setLastUpdate(null);
            // still continue to fetch to update in background
          }
        }
        const resp = await fetch(url, { cache:'no-store' });
        if(!resp.ok) throw new Error('HTTP '+resp.status);
        const j = await resp.json();

        // normalize: find best array inside JSON or use array directly
        let arr = [];
        if(Array.isArray(j)) arr = j;
        else if(Array.isArray(j.matches)) arr = j.matches;
        else {
          // prefer deepest array value
          const vals = Object.values(j).filter(v => Array.isArray(v));
          arr = vals.length ? vals[0] : [j];
        }

        // set/update
        dataRaw = Array.isArray(arr) ? arr : [arr];
        saveCache(dataRaw);
        snapshot = JSON.stringify(arr).slice(0,5000);
        renderGrid(dataRaw);

        // last update: try to get updatedAt field or Date header
        const tryUpdatedAt = (j.updatedAt || j.updated || j.lastUpdated || j.timestamp || resp.headers.get('last-modified')) || null;
        setLastUpdate(tryUpdatedAt || new Date());

      } catch(err){
        console.error('Load failed', err);
        if(!dataRaw || !dataRaw.length){
          grid.innerHTML = `<div class="empty">Failed to load data. Open console for details.</div>`;
          setLastUpdate(null);
        } else {
          // keep showing cached data
          console.warn('Using cached data fallback');
        }
      }
    }

    // initial
    (function init(){
      attachDelegation();
      useCacheIfPresent();
      loadData(DATA_URL);
      loadVisitorCounter();
      setInterval(()=> loadData(DATA_URL), 60*1000); // refresh every 60s
    })();

  })();
  </script>
</body>
</html>
